# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.
# Never commit real keys.

# Public address of the shop (used for Stripe's return links)
SITE_URL=http://localhost:3000
SHOP_NAME=Maison Elva

# Stripe (start with test keys: sk_test_... / whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CJdropshipping. Without CJ_API_KEY the shop uses a simulated supplier.
CJ_API_KEY=
# true = CJ creates sandbox orders that are never shipped. Use this for the first tests.
CJ_SANDBOX=true
# false = orders are created in CJ and you pay them in the CJ dashboard.
# true  = orders are paid automatically from your CJ balance.
CJ_AUTO_PAY=false
# Warehouse country to ship from (CN, or e.g. DE for CJ's German warehouse; shipping to CH still goes through customs)
CJ_FROM_COUNTRY=CN
# Optional fixed carrier; empty = cheapest option from CJ's freight calculator
CJ_LOGISTIC_NAME=

# Orders above this amount (in Rappen) wait for your manual check. 30000 = CHF 300.
HOLD_ORDERS_ABOVE_CENTS=30000

# Email via Resend (optional). Without it, emails are only logged.
RESEND_API_KEY=
MAIL_FROM=Maison Elva <bestellung@deine-domain.ch>
# Gets alerts about held or failed orders
ADMIN_EMAIL=

# Protects the daily tracking job. Vercel sends it automatically for cron jobs.
CRON_SECRET=

# Only for testing checkout with the example products and Stripe test keys
ALLOW_EXAMPLE_CHECKOUT=false
